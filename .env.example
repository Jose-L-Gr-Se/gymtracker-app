# Copia este archivo a .env y rellena con los valores de tu proyecto.
# Sin los valores de Supabase la app funciona en modo solo-local (invitado),
# sin login ni sincronización.

# ── Supabase (Dashboard → Settings → API) ────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# ── Google Sign-In (opcional) ────────────────────────────────
# Sin estos valores el botón "Continuar con Google" no se muestra: preferimos
# ocultarlo a ofrecer un botón que falla.
#
# Se obtienen en Google Cloud Console → APIs y servicios → Credenciales,
# creando IDs de cliente OAuth. El "web" es obligatorio (es el que valida
# Supabase); los de Android/iOS son los que usa la app en cada plataforma y
# se registran con el nombre de paquete com.joselgrse.gymtracker y la huella
# SHA-1 de la firma del build.
#
# Después hay que pegar el client ID y el secret WEB en:
#   Supabase → Authentication → Providers → Google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
