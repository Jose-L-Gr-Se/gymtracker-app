# Copia este archivo a .env y rellena con los valores de tu proyecto Supabase
# (Dashboard → Settings → API). Sin estos valores la app funciona en modo
# solo-local (invitado), sin login ni sincronización.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
